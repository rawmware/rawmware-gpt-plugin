# Copy to Vercel → Project → Settings → Environment Variables. Never commit real values.

# Required
GITHUB_TOKEN=            # fine-grained PAT; write scopes only needed for owner tools
OPERATOR_API_KEY=        # long random string: `openssl rand -hex 32`

# Owner tools
GITHUB_WRITE_REPOS=rawmware/*      # comma-separated allowlist for github_write
VERCEL_TOKEN=
VERCEL_TEAM_ID=
OPENAI_API_KEY=          # used ONLY for owner calls; public users must BYOK via x-openai-key

# Better scraping/search (all optional, keyless fallbacks exist)
BRAVE_API_KEY=
BROWSERLESS_TOKEN=
JINA_API_KEY=
META_APP_TOKEN=          # app_id|client_token for Instagram oEmbed
CONTEXT7_API_KEY=        # higher rate limits for plugin_call Context7

# Shared cache (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Identity / overrides (optional)
PUBLIC_URL=              # e.g. https://operator.rawmware.com
OWNER_GITHUB=rawmware
OWNER_CONTACT=           # hire link (Calendly, email form, site)
OWNER_BUSINESS=
OPERATOR_REPO=rawmware/rawmware-gpt-plugin
RATE_LIMIT_PER_MIN=60
OPENAI_MODEL=gpt-5-mini
