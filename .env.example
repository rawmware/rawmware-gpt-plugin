# Copy to Vercel → Project → Settings → Environment Variables. Never commit real values.

# Recommended
GITHUB_TOKEN=            # read-only PAT: lifts anonymous GitHub reads from 60 to 5,000/hr
OPERATOR_API_KEY=        # long random string: `openssl rand -hex 32` (owner-only features)

# GitHub OAuth for the Custom GPT (users act as themselves: private repos, PRs)
GITHUB_CLIENT_ID=        # github.com/settings/developers → New OAuth App
GITHUB_CLIENT_SECRET=

# Owner-only (never used for other users' requests)
GITHUB_WRITE_REPOS=rawmware/*      # allowlist when writing with the SERVER token
VERCEL_TOKEN=
VERCEL_TEAM_ID=
OPENAI_API_KEY=          # used ONLY for owner calls; public users must BYOK via x-openai-key

# Better scraping/search (all optional, keyless fallbacks exist)
BRAVE_API_KEY=           # search provider chain: Brave → Tavily → Serper → DuckDuckGo
TAVILY_API_KEY=
SERPER_API_KEY=
BROWSERLESS_TOKEN=
JINA_API_KEY=
META_APP_TOKEN=          # app_id|client_token for Instagram oEmbed
CONTEXT7_API_KEY=        # higher rate limits for plugin_call Context7

# Shared cache (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Identity / overrides (optional)
PUBLIC_URL=              # e.g. https://operator.rawmware.com
OPERATOR_REPO=rawmware/rawmware-gpt-plugin
RATE_LIMIT_PER_MIN=60
OPENAI_MODEL=gpt-5-mini
